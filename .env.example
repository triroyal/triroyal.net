# Resend API Key for contact form email delivery (obtain from https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Cloudflare Turnstile Secret Key (Serverless verification)
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Cloudflare Turnstile Public Site Key (Frontend React component)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...
